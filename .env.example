# Salin ke .env lalu sesuaikan:
#   cp .env.example .env

# ─── Autentikasi ────────────────────────────────────
# auto      = login UserGate jika API key diisi; tanpa login jika kosong (default)
# usergate  = wajib login UserGate
# none      = selalu tanpa login (terbuka)
# Biarkan kosong agar mode bisa diubah dari halaman Pengaturan.
AUTH_MODE=

# ─── UserGate (opsional; wajib untuk mode login) ────
# API Key dari dashboard UserGate (untuk login admin)
USERGATE_API_KEY=
# Base URL UserGate (default: https://usergate.sandalgurun.web.id/api/v1)
USERGATE_BASE_URL=https://usergate.sandalgurun.web.id/api/v1

# ─── Keamanan session ───────────────────────────────
# Kunci enkripsi secret di database. Kosong = dibuat otomatis di volume.
SECRET_KEY=
# Set true jika diakses via HTTPS
COOKIE_SECURE=false

# ─── Preferensi ─────────────────────────────────────
TZ=Asia/Jakarta

# ─── Opsional (biarkan kosong untuk memakai default) ─
# Base URL API Interlink (default: https://prod.interlinklabs.ai/api/v1)
ITLG_API_BASE=
# Direktori data di dalam container (default: /app/data)
ITLG_DATA_DIR=
